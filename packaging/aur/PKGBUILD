# Template for PKG-1. ship-it prints new pkgver and sha256sums values.
pkgname=spreadsheet-bin
pkgver=0.0.1
pkgrel=1
pkgdesc="A fast, lightweight spreadsheet for large CSV files"
arch=('x86_64')
url="https://YOUR_PAGES_DOMAIN"
license=('MIT' 'Apache-2.0')
source=("https://dl.example.com/releases/v${pkgver}/spreadsheet-${pkgver}-x86_64-linux.tar.gz")
sha256sums=('SKIP')

package() {
  cd "spreadsheet-${pkgver}-x86_64-linux"
  install -Dm755 spreadsheet "$pkgdir/usr/bin/spreadsheet"
  install -Dm644 spreadsheet.desktop "$pkgdir/usr/share/applications/spreadsheet.desktop"
}
