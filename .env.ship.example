# Copy to .env.ship (gitignored) and fill in. Never commit real tokens.
# API token scopes: Account > Cloudflare Pages: Edit, Account > Workers R2 Storage: Edit
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
R2_BUCKET=spreadsheet-releases
CF_PAGES_PROJECT=spreadsheet
# Pages project for the suite page at cronkite.cc (scripts/ship.sh suite-site)
CF_SUITE_PAGES_PROJECT=cronkite
# Public URL of the R2 bucket (custom domain or r2.dev), no trailing slash
DOWNLOAD_BASE_URL=https://dl.example.com
